{
  "name": "lingostack",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:build": "pnpm tauri build --debug --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:e2e:run": "wdio run wdio.conf.ts",
    "test:production-isolation": "node scripts/check-production-isolation.mjs",
    "release:local": "pwsh -NoProfile -File scripts/build-release.ps1",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "test:release": "node --test scripts/prepare-updater-release-config.test.mjs scripts/release-manifest.test.mjs && python scripts/test_publish_immutable.py && cargo test -p lingostack-app --bin verify-updater-signature"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@wdio/cli": "9.31.5",
    "@wdio/junit-reporter": "9.31.2",
    "@wdio/local-runner": "9.31.5",
    "@wdio/mocha-framework": "9.31.5",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.13.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "webdriverio": "9.31.5"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "vite": "^6.4.3",
      "deepmerge-ts": "^8.0.2",
      "@puppeteer/browsers": "^3.2.1",
      "nanoid": "^3.3.18",
      "glob": "10.5.0",
      "serialize-javascript": "^7.1.1"
    }
  }
}
